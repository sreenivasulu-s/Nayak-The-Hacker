# NPT v7 deployment secrets — NEVER commit real values.
POSTGRES_DB=npt
POSTGRES_USER=npt
POSTGRES_PASSWORD=replace-with-a-long-random-secret
NPT_SECRET_KEY=replace-with-a-32-byte-or-longer-random-secret
NPT_AUTH_MODE=local

# Optional production integrations
NPT_REDIS_URL=redis://redis:6379/0
NPT_DATABASE_URL=postgresql+psycopg://npt:${POSTGRES_PASSWORD}@postgres:5432/npt
OLLAMA_BASE_URL=http://ollama:11434
